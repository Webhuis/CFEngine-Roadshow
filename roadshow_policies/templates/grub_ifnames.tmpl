# Webhuis template voor default grub with net.ifnames=0
# Forces predictable interface names.
#
# Do not edit
#
[%CFEngine any:: %]
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`
GRUB_CMDLINE_LINUX_DEFAULT="quiet net.ifnames=0"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=true
