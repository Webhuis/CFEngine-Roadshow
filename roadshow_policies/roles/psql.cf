bundle agent psql {

vars:

  "role_name"                                  string => "postgresql database cluster server";

  "bundles[role_profile]"                         string => "$(role_profile).cf";
  "bundles[postgresql]"                        string => "$(sys.flavor)/postgresql.cf";
  "pool_bundles"                                slist => { "$(sys.workdir)/pool/bundles/role_profile.cf" };
  "pool_role_bundles"                           slist => findfiles("$(sys.workdir)/pool/bundles/$(this)/*.cf");


  "sequence"                                    slist => getindices("bundles");
  "inputs"                                      slist => { getvalues("bundles", @(pool_bundles), @(pool_role_bundles)) };

methods:

  "We desire the postgresql server"         usebundle => "postgresql";

reports:

  "$(this.bundle) role inputs: $(inputs)";

}
