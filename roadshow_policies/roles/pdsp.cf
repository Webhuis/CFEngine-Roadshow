bundle agent pdsp {

vars:

  "role_name"                         string => "Powerdns PostgreSQL Internet name server slave";
  "role_profile"                         string => "role_profile_std_sup";

  "bundles[role_profile]"                string => "$(role_profile).cf";
  "bundles[pdsp_server]"              string => "${sys.flavor}/pdsp_server.cf";

  "sequence"                           slist => getindices("bundles");
  "inputs"                             slist => getvalues("bundles");

methods:

  "The PowerDNS server"            usebundle => "pdsp_server";

reports:

  "$(this.bundle) app.inputs:$(role_name), $(inputs)";

}

