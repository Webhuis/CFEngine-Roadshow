bundle agent ggwy {

vars:

  "role_name"                         string => "The gateway gateway";

methods:

  "We are the gateway of all"      usebundle => "gateway_gateway";

reports:

  "${this.bundle} role name: $(role_name)";
  "$(this.bundle) role data: $(role_profile)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
