bundle agent ggwy {

vars:

  "role_name"                         string => "I am the Gateway of Gateways";
  "bundles[local_gateway]"            string => "${sys.flavor}/local_gateway.cf";
  "bundles[gateway_tools]"            string => "${sys.flavor}/gateway_tools.cf";

methods:

  "We are the gateway of all"      usebundle => "local_gateway";
  "We desire gateway tooling"      usebundle => "gateway_tools";

reports:

  "${this.bundle} role name: $(role_name)";
  "$(this.bundle) role data: $(role_profile)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
