bundle agent w3ci {

vars:

  "role_name"                                  string => "HTTP HTTPS w3c compliant internal apache2 http nginx https Webserver";

methods:

  "We need the Apache Webserver"            usebundle => "apache2";
  "We need the Apache Webserver"            usebundle => "$(sys.flavor)/apache_php";
  "We need nginx serving https"             usebundle => "nginx";

reports:

  "${this.bundle} role name: $(role-name)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
