bundle agent cfeh {

vars:

  "role_name"                                  string => "CFEngine policy hub";

# "bundles[role_profile]"                      string => "$(role_profile).cf";
  "bundles[cfe_hub]"                           string => "cfe_hub.cf";
# "pool_bundles"                                slist => { "$(sys.workdir)/pool/bundles/role_profile.cf" };
# "pool_role_bundles"                           slist => findfiles("$(sys.workdir)/pool/bundles/$(this)/*.cf");


# "sequence"                                    slist => getindices("bundles");
# "inputs"                                      slist => { getvalues("bundles", @(pool_bundles), @(pool_role_bundles)) };
  "inputs"                                      slist => getvalues("bundles");

methods:

  "We are the CFEngine policy Hub" usebundle => "cfe_hub";

reports:

  "$(this.bundle) role name: $(role_name)";
  "$(this.bundle) role data: $(role_profile)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
