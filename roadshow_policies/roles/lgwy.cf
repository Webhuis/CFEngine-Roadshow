bundle agent lgwy {

vars:

  "role_name"                         string => "Life gateway";
  "role_data"                         string => "role_data_life";

  "bundles[role_data]"                string => "$(role_data).cf";
  "bundles[life_gwy]"                 string => "life_gwy.cf";

  "sequence"                           slist => getindices("bundles");
  "inputs"                             slist => getvalues("bundles");

methods:

  "We are the CFEngine policy Hub" usebundle => "life_gwy";

reports:

  "$(this.bundle) role name: $(role_name)";
  "$(this.bundle) role data: $(role_data)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
