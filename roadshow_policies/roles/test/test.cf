bundle agent test {

vars:

  "role_name"                                  string => "Test VM for policy testing";

  "bundles[test_set]"                          string => "test_set.cf";

  "inputs"                                      slist => getvalues("bundles");

methods:

  "We are the policy test node"             usebundle => "test_set";

reports:

  "$(this.bundle) role name: $(role_name)";
  "$(this.bundle) role data: $(role_profile)";
  "$(this.bundle) role inputs: $($(classify.role).inputs)";

}
