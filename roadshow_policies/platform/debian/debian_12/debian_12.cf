bundle agent debian_12 {

vars:

  "pkg[autofs]"                             string => "*";
  "pkg[autofs-ldap]"                        string => "*";
  "pkg[dnsutils]"                           string => "*";
  "pkg[ldap-utils]"                         string => "*";
  "pkg[libpam-ldapd]"                       string => "*";
  "pkg[libnss-ldapd]"                       string => "*";
  "pkg[locales-all]"                        string => "*";
  "pkg[openssh-server]"                     string => "*";
  "pkg[python3-zmq]"                        string => "*";
  "pkg[smbclient]"                          string => "*";

  "name"                                    string => "bookworm";
  "updates"                                 string => " bookworm-security"; # The space is intentional

  "ip_cmd"                                  string => "/usr/sbin/ip";

methods:

  "We desire bookworm packages"          usebundle => packages("debian_12.pkg");

reports:

  "$(this.bundle):";

}
