bundle agent dhcp_ldap_update (suffix, nic, ip_address, mac, vlan_number) {

classes:

  "parsed_ip"                      expression => regextract("^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})", "$(ip_address)", "part");
  "ldap_success"                   expression => strcmp("$(status)", "0");
  "ldap_no_such_object"            expression => strcmp("$(status)", "32");

vars:

  "ddns_name"                          string => "$(sys.uqhost)$(suffix)";
  "ddns_name_can"                      string => canonify("$(ddns_name)");
  "subnet"                             string => "$(part[1]).$(part[2]).$(part[3]).0";
  "vlan"                               string => "Vlan-$(vlan_number)";
  "ip"                                 string => "$(ip_address)";
  "ip_can"                             string => canonify("$(ip)");
  "mac_address"                        string => "$(mac)";
  "mac_address_can"                    string => canonify("$(mac)");
  "ldap_passwd"                        string => "M@rkBurge55";

  "ldap_search"                 string => "/usr/bin/ldapsearch -x -w M@rkBurge55 -H ldap://mihrwhpdcsw1.sw.webhuis.nl/ -b cn=$(ddns_name),cn=fixed,cn=$(subnet),cn=$(vlan),cn=dhcp,dc=sw,dc=webhuis,dc=nl -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl";

  "result"                             string => execresult("$(ldap_search) | grep -e 'result: ' -e 'dhcpHWAddress: ethernet ' -e 'dhcpStatements: fixed-address '", useshell);
  "ldap_result_lines"                   slist => string_split("$(result)", "\n", 99);
 #"cn_line"                             slist => grep("cn: ", "ldap_result_lines");
  "hw_line"                             slist => grep("dhcpHWAddress.*", "ldap_result_lines");
  "ip_line"                             slist => grep("dhcpStatements.*", "ldap_result_lines");
  "status_list"                         slist => grep("result.*", "ldap_result_lines"); 
  "status_str"                         string => nth("status_list", 0); 
  "status_split"                        slist => string_split("$(status_str)", " ", "3" ); 
  "status"                             string => nth("status_split", "1" );
 #"ldap_cn_l"                           slist => string_split("$(cn_line)", " ", 9);
 #"ldap_cn"                            string => lastnode("$(ldap_cn_l)", " ");
 #"ldap_cn_can"                        string => canonify("$(ldap_cn)");

files:

 ldap_no_such_object::
  "/etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_template  => "$(sys.workdir)/roadshow_inputs/role/templates/ldap_host.tmpl";

methods:

 ldap_success::
  "Determine ldap action"           usebundle => ldap_action(  "$(ddns_name)", "$(subnet)", "$(vlan)", "$(ip_address)", "$(mac_address)" 
                                                            , "$(ip_line)", "$(hw_line)");

commands:

  "/usr/bin/echo dhcp ldap commands section";
 ldap_success:: 
  "/usr/bin/echo dhcp ldap check_modify!";
 ldap_no_such_object:: 
  "/usr/bin/echo We need to add the ldap object $(ddns_name) ";
  "/usr/bin/ldapadd -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";

reports:

  "$(this.bundle) host: $(ddns_name) $(vlan) $(subnet) $(ip) $(mac_address)";
  "$(this.bundle) ldap: $(ldap_cn) $(ldap_ip) $(ldap_hw)";
  "$(this.bundle) ldap status: $(status)";
  "$(this.bundle) ldapsearch result: $(result)";
  "$(this.bundle) ldap_result_lines : $(ldap_result_lines)";

}

bundle agent ldap_action ( ddns_name, subnet, vlan, ip_address, mac, ip_line, hw_line) {

classes:

  "ip_match"                          expression => strcmp($(ip_can), $(ldap_ip_can));
  "mac_match"                         expression => strcmp($(mac_can), $(ldap_hw_can));

files:

 !ip_match|!mac_match::
  "/etc/ldap/$(ddns_name).$(sys.domain).ldapmodify.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_template  => "$(sys.workdir)/roadshow_inputs/role/templates/ldap_modify_host.tmpl";

vars:

  "ip_can"                             string => canonify("$(ip_address)");
  "mac_can"                            string => canonify("$(mac)");
  "ldap_ip_list"                        slist => string_split("$(ip_line)", " ", "9");
  "ldap_ip"                            string => nth("ldap_ip_list", 2);
  "ldap_ip_can"                        string => canonify("$(ldap_ip)");
  "ldap_hw_list"                        slist => string_split("$(hw_line)", " ", "9");
  "ldap_hw"                            string => nth("ldap_hw_list", 2);
  "ldap_hw_can"                        string => canonify("$(ldap_hw)");

commands:

  "/usr/bin/echo ldap_action ddns_name exists: check ldapmodify!";

 ip_match.mac_match::
  "/usr/bin/echo ldap_action ip and mac match!";
 !ip_match|!mac_match::
  "/usr/bin/echo ldap_action ip or mac changed ldapmodify!";
  "/usr/bin/ldapmodify -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapmodify.command";

reports:

  "$(this.bundle) ip_can : $(ip_can)";
  "$(this.bundle) mac_can : $(mac_can)";
  "$(this.bundle) ip_line: $(ip_line)";
  "$(this.bundle) ldap_ip_list : $(ldap_ip_list)";
  "$(this.bundle) ldap_ip : $(ldap_ip)";
  "$(this.bundle) hw_line: $(hw_line)";
  "$(this.bundle) ldap_hw_can : $(ldap_hw_can)";
  "$(this.bundle) ldap_hw_can : $(ldap_hw_can)";

 ip_ldap.mac_match:: 
  "$(this.bundle) ip's match : vlan $(vlan) *$(ip_can)* *$(ldap_ip_can)* *$(mac_can)* *$(ldap_hw_can)*";
 !ip_ldap|!mac_match:: 
  "$(this.bundle) ip's do not match : vlan $(vlan) *$(ip_can)* *$(ldap_ip_can)* *$(mac_can)* *$(ldap_hw_can)*";

}

