bundle agent dhcp_ldap_update (suffix, nic, ip_address, mac, vlan_number) {

classes:

  "parsed_ip"                      expression => regextract("^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})", "$(ip_address)", "part");
  "cn_ldap"                        expression => strcmp("$(ddns_name_can)", "$(ldap_cn_can)");
  "ip_ldap"                        expression => strcmp("$(ip_address_can)", "$(ldap_ip_can)");
  "hw_ldap"                        expression => strcmp("$(mac_address_can)", "$(ldap_hw_can)");

vars:

  "ddns_name"                          string => "$(sys.uqhost)$(suffix)";
  "ddns_name_can"                      string => canonify("$(ddns_name)");
  "subnet"                             string => "$(part[1]).$(part[2]).$(part[3]).0";
  "vlan"                               string => "Vlan-$(vlan_number)";
 #"ip_address"                         string => "$(ip_address)";
  "mac_address"                        string => "$(mac)";
  "ldap_passwd"                        string => "M@rkBurge55";

  "ldap_search"                 string => "/usr/bin/ldapsearch -x -w M@rkBurge55 -H ldap://mihrwhpdcsw1.sw.webhuis.nl/ -b cn=$(ddns_name),cn=fixed,cn=$(subnet),cn=$(vlan),cn=dhcp,dc=sw,dc=webhuis,dc=nl -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl";

  "result"                             string => execresult("$(ldap_search) | grep -e 'cn: ' -e 'dhcpHWAddress: ethernet ' -e 'dhcpStatements: fixed-address '", useshell);
  "ldap_result_lines"                   slist => string_split("$(result)", "\n", 99);
  "cn_line"                             slist => filter("cn: ", "ldap_result_lines", "true", "true", 1); 
  "hw_line"                             slist => filter("dhcpHWAddress: ethernet ", "ldap_result_lines", "true", "true", 2); 
  "ip_line"                             slist => filter("dhcpStatements: fixed-address ", "ldap_result_lines", "true", "true", 3); 
  "ldap_cn_l"                           slist => string_split("$(cn_line)", " ", 9);
  "ldap_cn"                            string => lastnode("$(ldap_cn_l)", " ");
  "ldap_cn_can"                        string => canonify("$(ldap_cn)");
  "ldap_ip_l"                           slist => string_split("$(ip_line)", " ", 9);
  "ldap_ip"                            string => lastnode("$(ldap_ip_l)", " ");
  "ldap_ip_can"                        string => canonify("$(ldap_ip)");
  "ip_address_can"                     string => canonify("$(ip_address)");
  "ldap_hw_l"                           slist => string_split("$(hw_line)", " ", 9);
  "ldap_hw"                            string => lastnode("$(ldap_hw_l)", " ");
  "ldap_hw_can"                        string => canonify("$(ldap_hw)");
  "mac_address_can"                    string => canonify("$(mac_address)");

files:

  "/etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_template  => "$(sys.workdir)/roadshow_inputs/role/templates/ldap_host.tmpl";

#methods:
# !cn_ldap:: 
#  "We need to add the ldap object"  usebundle => ldap_command("$(ddns_name)");

commands:

  "/usr/bin/echo ldap commands section";

 cn_ldap::
  "/usr/bin/echo ldap ddns_name exists: check ldapmodify!";

 !cn_ldap::

  "/usr/bin/echo ldap ddns_name does exist:  $(ddns_name) $(ldap_ip)!";
  "/usr/bin/ldapadd -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";

 !(ip_ldap.hw_ldap).cn_ldap::

  "/usr/bin/echo ldap ip or mac changed ldapmodify!";
  "/usr/bin/ldapmodify -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";


reports:

  "$(this.bundle) ldap  : $(ddns_name)";
  "$(this.bundle) vlan  : $(vlan_number)";
  "$(this.bundle) subnet: $(subnet)";
  "$(this.bundle) ip_address : $(ip_address)";
  "$(this.bundle) mac   : $(mac_address)";

  "$(this.bundle) ldap_cn_l : $(ldap_cn_l)";
  "$(this.bundle) ldap_ip_l : $(ldap_ip_l)";
  "$(this.bundle) ldap_hw_l : $(ldap_hw_l)";
  "$(this.bundle) ldap_cn : $(ldap_cn)";
  "$(this.bundle) ldap_ip : $(ldap_ip)";
  "$(this.bundle) ldap_ip_can : $(ldap_ip_can)";
  "$(this.bundle) ip_address_can : $(ip_address_can)";
  "$(this.bundle) ldap_hw : $(ldap_hw)";
  "$(this.bundle) ldap_hw_can : $(ldap_hw_can)";
  "$(this.bundle) mac_address_can : $(mac_address_can)";

  "$(this.bundle) ldapsearch result: $(result)";
  "$(this.bundle) ldap_result_lines : $(ldap_result_lines)";

 cn_ldap:: 
  "$(this.bundle) ddns_name and cn exist : *$(ddns_name)* *$(ldap_cn)*";

 !cn_ldap:: 
  "$(this.bundle) ddns_name available but cn does not exist : $(ddns_name), ldapadd";

 ip_ldap.hw_ldap::
  "$(this.bundle) ldap ok: ip *$(ip_address_can)* ldap-ip *$(ldap_ip_can)*! mac *$(mac_address_can)* ldap-hw *$(ldap_hw_can)*!";

 !(ip_ldap.hw_ldap).cn_ldap::
  "$(this.bundle) ldap nok: ip *$(ip_address_can)* mac *$(mac_address_can)* ldapmodify!";

}
