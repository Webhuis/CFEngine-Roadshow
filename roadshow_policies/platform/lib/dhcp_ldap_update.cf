bundle agent dhcp_ldap_update (suffix, nic, ip_address, mac, vlan_number) {

classes:

  "parsed_ip_$(nic)"               expression => regextract("^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})", "$(ip_address)", "part");
  "in_ldap_$(nic)"                 expression => regcmp(".*ethernet.*fixed-address.*", "$(result_$(nic)).");

vars:

  "ddns_name_$(nic)"                   string => "$(sys.uqhost)$(suffix)";
  "subnet_$(nic)"                      string => "$(part[1]).$(part[2]).$(part[3]).0";
  "vlan_$(nic)"                        string => "Vlan-$(vlan_number)";
  "mac_address_$(nic)"                 string => "$(mac)";
  "ldap_passwd"                        string => "M@rkBurge55";

  "ldap_search_$(nic)"                 string => "/usr/bin/ldapsearch -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -b cn=$(ddns_name_$(nic)),cn=fixed,cn=$(subnet_$(nic)),cn=$(vlan_$(nic)),cn=dhcp,dc=sw,dc=webhuis,dc=nl -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl";

  "result_$(nic)"                      string => execresult("$(ldap_search_$(nic)) -w $(ldap_passwd)", "noshell");

  "dev_$(nic)"                         string => execresult("$($(sys.flavor).ip_cmd) link show dev $(nic)","noshell");

files:

  "/etc/ldap/$(ddns_name_$(nic)).$(sys.domain).ldapadd.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_template  => "$(sys.workdir)/roadshow_inputs/role/templates/ldap_host.tmpl";

commands:

 "!in_ldap_$(nic)"::
  "/usr/bin/ldapadd -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";
 # "/usr/bin/ldapadd -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -y /root/.ldap -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";
 # -y /root/.ldap does not work, dropping back to hardcoded password

reports:

  "$(this.bundle) dev   : $(dev_$(nic))";
  "$(this.bundle) ldap  : $(ddns_name_$(nic))";
  "$(this.bundle) vlan  : $(vlan_number_$(nic))";
  "$(this.bundle) subnet: $(subnet_$(nic))";
  "$(this.bundle) mac   : $(mac_address_$(nic))";
  "$(this.bundle) ldap_search_$(nic)   : $(ldap_search_$(nic))";

 "in_ldap_$(nic)"::
  "$(this.bundle): $(ddns_name_$(nic)) in ldap: $(result_$(nic))";
 "!in_ldap_$(nic)"::
  "$(this.bundle): $(ddns_name_$(nic)) not in ldap: $(result_$(nic))";

}
