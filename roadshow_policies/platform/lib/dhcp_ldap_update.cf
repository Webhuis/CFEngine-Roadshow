bundle agent dhcp_ldap_update (suffix, nic, ip_address, mac, vlan_number) {

classes:

  "parsed_ip"                      expression => regextract("^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})", "$(ip_address)", "part");
  "ip_ldap"                        expression => regcmp("$(ip_address)", "$(ldap_ip).");
  "hw_ldap"                        expression => regcmp("$(mac_address)", "$(ldap_hw).");

vars:

  "ddns_name"                          string => "$(sys.uqhost)$(suffix)";
  "subnet"                             string => "$(part[1]).$(part[2]).$(part[3]).0";
  "vlan"                               string => "Vlan-$(vlan_number)";
 #"ip_address"                         string => "$(ip_address)";
  "mac_address"                        string => "$(mac)";
  "ldap_passwd"                        string => "M@rkBurge55";

  "ldap_search"                 string => "/usr/bin/ldapsearch -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -b cn=$(ddns_name),cn=fixed,cn=$(subnet),cn=$(vlan),cn=dhcp,dc=sw,dc=webhuis,dc=nl -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl";

  "result"                             string => execresult("$(ldap_search) -w $(ldap_passwd) | grep -e 'cn: ' -e 'dhcpHWAddress: ethernet ' -e 'dhcpStatements: fixed-address '", useshell);
  "ldap_result_lines"                   slist => string_split("$(result)", "\n", 99);
  "cn_line"                             slist => sublist("ldap_result_lines", "head", 1);
  "hw_2"                                slist => sublist("ldap_result_lines", "tail", 2);
  "hw_line"                             slist => sublist("hw_2", "head", 1);
  "ip_line"                             slist => sublist("ldap_result_lines", "tail", 1);
  "result_index"                        slist => getindices("ldap_result_lines");
  "result_values"                       slist => getvalues("ldap_result_lines");
  "ldap_cn_l"                           slist => string_split("$(cn_line)", " ", 9);
  "ldap_cn"                            string => lastnode("$(ldap_cn_l)", " ");
  "ldap_ip_l"                           slist => string_split("$(ip_line)", " ", 9);
  "ldap_ip"                            string => lastnode("$(ldap_ip_l)", " ");
  "ldap_hw_l"                           slist => string_split("$(hw_line)", " ", 9);
  "ldap_hw"                            string => lastnode("$(ldap_hw_l)", " ");


 #"dev_$(nic)"                         string => execresult("$($(sys.flavor).ip_cmd) link show dev $(nic)","noshell");

files:

  "/etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_template  => "$(sys.workdir)/roadshow_inputs/role/templates/ldap_host.tmpl";

#methods:

#  "We need to add the ldap object"  usebundle => ldap_command("$(ddns_name)", "$(subnet)", "$(vlan)", "$(ip_address)", "$(mac_address)");

commands:

 "!ip_ldap.!hw_ldap":: 
  "/usr/bin/ldapadd -v -x -H ldap://$($(classify.organisation).dhcp_ldap)/ -D cn=CFEngine,ou=users,dc=sw,dc=webhuis,dc=nl -w M@rkBurge55 -f /etc/ldap/$(ddns_name).$(sys.domain).ldapadd.command";

 "ip_ldap.!hw_ldap"::
  "/usr/bin/echo ldap: ldapmodify needed!";   

 "!ip_ldap.hw_ldap"::
  "/usr/bin/echo ldap: ldapmodify needed!";   

reports:

 #"$(this.bundle) dev   : $(dev_$(nic))";
  "$(this.bundle) ldap  : $(ddns_name)";
  "$(this.bundle) vlan  : $(vlan_number)";
  "$(this.bundle) subnet: $(subnet)";
  "$(this.bundle) ip_address : $(ip_address)";
  "$(this.bundle) result : $(result)";
  "$(this.bundle) ldap_result_lines : $(ldap_result_lines)";
  "$(this.bundle) ldap_cn: $(ldap_cn)";
  "$(this.bundle) ldap_ip: $(ldap_ip)";
  "$(this.bundle) ldap_hw: $(ldap_hw)";

 "ip_ldap"::
  "$(this.bundle): $(ip_address) in ldap";
 "mac_ldap"::
  "$(this.bundle): $(mac_address) in ldap";
 "!ip_ldap.!hw_ldap"::
  "$(this.bundle): $(ddns_name) not in ldap: $(result)";

}
