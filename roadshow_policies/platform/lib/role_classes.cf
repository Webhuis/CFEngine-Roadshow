bundle common role_classes {

classes:

  "has_hosts_var"                  expression => isvariable("hosts_var");
  "has_admin_var"                  expression => isvariable("admin_var");

vars:

  "hosts_var"                          string => "$(role_data.hosts_ip)";
  "admin_var"                          string => "$(role_data.admin_ip)";

}
