bundle agent ddns_update (ip_address, suffix) {

classes:

  "parsed_ip"                                expression => regextract("^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})", $(ip_address), "part");

  "a_record_dns"                             expression => isvariable("dig_host2ip"); 
  "ptr_record_dns"                           expression => isvariable("dig_ip2host");

 a_record_dns::
  "a_record"                                 expression => strcmp("$(host2ip_can)", "..*");

 ptr_record_dns::
  "ptr_record"                               expression => strcmp("$(ip2host_can)", "..*");

vars:

  "ddns_name"                                    string => "$(sys.uqhost)$(suffix)";
  "mdns"                                         string => "$($(classify.organisation).mdns)";
  "mdns_key"                                     string => "$($(classify.organisation).mdns_key)";
  "ttl"                                          string => "$($(classify.organisation).ttl)";
  "arpa_zone"                                    string => "$(part[3]).$(part[2]).$(part[1]).in-addr.arpa.";
  "arpa_address"                                 string => "$(part[4]).$(part[3]).$(part[2]).$(part[1]).in-addr.arpa.";

  "dig_host2ip"                                  string => execresult("/usr/bin/dig +short $(ddns_name).$(sys.domain)", "noshell");
  "host2ip_can"                                  string => canonify("$(dig_host2ip)");
  "dig_ip2host"                                  string => execresult("/usr/bin/dig +short -x $(ip_address)", "noshell");
  "ip2host_can"                                  string => canonify("$(dig_ip2host)");

files:

 !a_record|!ptr_record::
  "/etc/dhcp/$(ddns_name).$(sys.domain).nsupdate.command"
    create         => "true",
    perms          => mog("644","root","root"),
    edit_line      => edit_nsupdate_command($(mdns), $(ddns_name), $(ttl), $(ip_address), $(arpa_zone), $(arpa_address));

commands:

 !a_record|!ptr_record::
  "/usr/bin/nsupdate -d -v -k $(mdns_key) /etc/dhcp/$(ddns_name).$(sys.domain).nsupdate.command";

reports:

  "$(this.bundle): $(ddns_name).$(sys.domain), $(ip_address)";
  "$(this.bundle): dig_host2ip $(dig_host2ip) $(host2ip_can)";
  "$(this.bundle): dig_ip2host $(dig_ip2host) $(ip2host_can)";
  "$(this.bundle): mdns, $(mdns)";
  "$(this.bundle): mdns_key, $(mdns_key)";
#a_record::
# "$(this.bundle): $(ddns_name).$(sys.domain), $(ip_address)";
 a_record_dns.ptr_record_dns::
  "$(this.bundle) DNS is Ok!";
 !a_record_dns|!ptr_record_dns::
  "$(this.bundle) update DNS!";

}

bundle edit_line  edit_nsupdate_command (mdns, ddns_name, ttl, ip_address, arpa_zone, arpa_address) {

delete_lines:

  ".*";

insert_lines:

 "server $(mdns)
  zone $(sys.domain)
  update add $(ddns_name).$(sys.domain). $(ttl) A $(ip_address)

  zone $(arpa_zone)
  update add $(arpa_address) $(ttl) PTR $(ddns_name).$(sys.domain).
  send";


}
