bundle agent interface_nic (nic) {

vars:

  "zones"                                   slist => { "$(role_profile.zones)" };
  "interfaces_available"                    slist => {@(sys.interfaces)};

methods:

  "persistent nic"                      usebundle => persistent_link("$(role_profiel.num_interfaces)");
 

reports:

  "$(this.bundle) role zones: $(role_profile.zones)";
  "$(this.bundle) available: $(interfaces_available)";

}
