bundle agent etc_hosts {

classes:

 "valid_hosts_ip"                          comment    => "Process the IP Addresses.",
                                           expression => regcmp("(1[0-9]{0,2}|[3-9][0-9]{0,1}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])",
            "$(hosts_ip)"
            );
vars:

  "hosts_ip"                                   string => "$(role_data.hosts_ip)";

files:

 valid_hosts_ip::
  "/etc/hosts"
  comment                   => "/etc/hosts voor elke host",
  create                    => "true",
  perms                     => mo("644","root"),
  edit_template             => "$(sys.workdir)/roadshow_inputs/templates/etc_hosts.tmpl",
  action                    => r_immediate;

reports:

 valid_hosts_ip::
  "$(this.bundle) etc_hosts_nic: $(hosts_ip)";

 !valid_hosts_ip::
   "$(this.bundle): etc_hosts_nic bad hosts_ip! $(hosts_ip)";

}
