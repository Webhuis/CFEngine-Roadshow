bundle agent domain_data_driven_policies {

methods:

 has_resolvers::
  "We require hostname resolution"          usebundle => resolv_conf;

 has_ntp_servers::
  "Accurate time is important"              usebundle => time_conf;

reports:

  "$(this.bundle): I am doing host driven policies";

 has_resolvers::
  "$(this.bundle): resolvers $($(classify.location).resolvers)";

 has_ntp_servers::
  "$(this.bundle) openssh server and client";

 !has_resolvers::
  "$(this.bundle) no resolvers!";

 !has_ntp_servers::
  "$(this.bundle) no ntp servers";

}
