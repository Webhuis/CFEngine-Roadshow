bundle agent host_data_driven_policies {

methods:

 123_ip::
  "supply etc_hosts with a valid IP"        usebundle => etc_hosts;

 22_ip::
  "openssh server and client"               usebundle => sshd_config;

#has_ddns_index::
# "Check the soft IP Addresses given"       usebundle => check_ip("$(role_profile.ddns[$(role_profile.ddns_index)][ip])");

#!bad_ip.mac_ok::
# "We update dhcp_ldap"                     usebundle => dhcp_ldap_update("$(role_profile.ddns[$(role_profile.ddns_index)][suffix])",
#                                                                         "$(role_profile.ddns[$(role_profile.ddns_index)][nic])",
#                                                                         "$(role_profile.ddns[$(role_profile.ddns_index)][ip])",
#                                                                         "$(role_profile.ddns[$(role_profile.ddns_index)][mac])",
#                                                                         "$(role_profile.ddns[$(role_profile.ddns_index)][vlan])");

#!bad_ip::
# "We update ddns"                          usebundle => ddns_update("$(role_profile.ddns[$(role_profile.ddns_index)][nic])",
#                                                                    "$(role_profile.ddns[$(role_profile.ddns_index)][ip])",
#                                                                    "$(role_profile.ddns[$(role_profile.ddns_index)][suffix])");

reports:

  "$(this.bundle): I am doing host driven policies";

 has_hosts_var::
  "$(this.bundle) supply etc_hosts with a valid IP";

 has_admin_var::
  "$(this.bundle) openssh server and client";

 !has_hosts_var::
  "$(this.bundle) no valid etc_hosts variable";

 !has_admin_var::
  "$(this.bundle) no valid admin variable";

}
