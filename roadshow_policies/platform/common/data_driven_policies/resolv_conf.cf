bundle agent resolv_conf(resolvers) {

classes:

 "valid_resolvers"                         comment    => "Oh, the horror! Process the list of IP Addresses.",
                                           expression => every(
"(25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[\.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[\.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[\.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})",
            $(resolvers)
            );

 files:

  "/etc/resolv.conf"
  comment                   => "Domain resolv.conf door class_domain",
  create                    => "true",
  perms                     => mo("644","root"),
  action                    => r_immediate,
  edit_template             => "$(sys.workdir)/roadshow_inputs/templates/resolv.conf.tmpl";

reports:

  "$(this.bundle): My mission is standardized resolv.conf setup with: $(resolvers)";

 valid_resolvers::
  "$(this.bundle) resolvers: $(resolvers)";

 !valid_resolvers::
   "$(this.bundle): invalid resolvers!";

}
