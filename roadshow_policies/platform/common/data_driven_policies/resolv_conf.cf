bundle agent resolv_conf {

classes:

 "valid_resolvers"                         comment    => "Oh, the horror! Process the list of IP Addresses.",
                                           expression => reglist( @(resolvers),
"(1[0-9]{0,2}|[3-9][0-9]{0,1}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])");

vars:

  "resolvers"                                   slist => { "$($(classify.location).resolvers)" };

files:

 valid_resolvers::
  "/etc/resolv.conf"
  comment                   => "Domain resolv.conf door class_domain",
  create                    => "true",
  perms                     => mo("644","root"),
  action                    => r_immediate,
  edit_template             => "$(sys.workdir)/roadshow_inputs/templates/resolv.conf.tmpl";

reports:

  "$(this.bundle): My mission is standardized resolv.conf setup with: $(resolvers)";

 valid_resolvers::
  "$(this.bundle) resolvers: $(resolvers)";

 !valid_resolvers::
   "$(this.bundle): invalid resolvers! @(resolvers)";

}
