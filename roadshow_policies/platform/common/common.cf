bundle agent common {

files:

  "/root/.ldap"
    perms          => mog("400","root","root");

  "/etc/dhcp/webhuis.nl.update"
    perms          => mog("400","root","root");


methods:

  "We desire a clean house"                 usebundle => housekeeping,
                                              comment => "We clean up first, we might need the diskspace";

 has_sudoer_rules::
  "Prepare for users"                       usebundle => manage_users( "common_users.users",  $(common_users.sudoer_rules) );

 any::

  "We require configured osi layers 1-2-3"  usebundle => osi_123;

  "Host data driven policies go here"       usebundle => host_data_driven_policies;

  "Domain data driven policies go here"     usebundle => domain_data_driven_policies;

  "Basic environment stuff"                 usebundle => basic_environment;
  "We use LDAP Authentication"              usebundle => authentication;

 has_ddns_index::
  "Check the soft IP Addresses given"       usebundle => check_ip("$(role_profile.ddns[$(role_profile.ddns_index)][ip])");

 !bad_ip.mac_ok::
  "We update dhcp_ldap"                     usebundle => dhcp_ldap_update("$(role_profile.ddns[$(role_profile.ddns_index)][suffix])",
                                                                          "$(role_profile.ddns[$(role_profile.ddns_index)][nic])",
                                                                          "$(role_profile.ddns[$(role_profile.ddns_index)][ip])",
                                                                          "$(role_profile.ddns[$(role_profile.ddns_index)][vlan])");

 !bad_ip::
  "We update ddns"                          usebundle => ddns_update("$(role_profile.ddns[$(role_profile.ddns_index)][nic])",
                                                                     "$(role_profile.ddns[$(role_profile.ddns_index)][ip])",
                                                                     "$(role_profile.ddns[$(role_profile.ddns_index)][suffix])");
commands:

  "/usr/bin/wget -O /root/.ldap http://mirror.webhuis.nl/ldap/.ldap";
  "/usr/bin/wget -O /etc/dhcp/webhuis.nl.update http://mirror.webhuis.nl/ddns/webhuis.nl.update";

reports:

  "$(this.bundle) ddns variable from cmmon bundle: $(ddns[$(ddns_index)])";
  "$(this.bundle) classified ddns variable from common bundle: $(role_profile.ddns[$(role_profile.ddns_index)])";
  "$(this.bundle) nic values: $(role_profile.nic_values)";
  "$(this.bundle) ip list: $(role_profile.ip_list)";

  "$(this.bundle): I am checking basic interface stuff first, $(role_profile.nic[$(role_profile.nic_index)]).";
  "$(this.bundle): I am doing common and data driven policies.";

 !bad_ip::
  "$(this.bundle) The soft ip addresses supplied are Ok.";

 bad_ip::
  "$(this.bundle) Invalid soft ip addresses are being supplied, no processing of soft ip address policies is going to take place.";

}

bundle common platform_common_classes {

classes:

  "has_sudoer_rules"     expression => isvariable("common_users.sudoer_rules");

}
