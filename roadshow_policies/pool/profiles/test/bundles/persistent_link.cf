bundle agent persistent_link (zones) {

vars:

 #"zone"                            string => "$(zones)";
  "nic"                             string => "$(zone_$(zones).$(zones)_nic)";
  "mac"                             string => "$(zone_$(zones).$(zones)_mac)";

files:

  "/etc/systemd/network/*"
    file_select    => all,
    delete         => tidy;

  "/etc/systemd/network/$(nic)_persistent.link"
    comment                                => "one file per nic",
    create                                 => "true",
    perms                                  => mo("644", "root"),
    action                                 => immediate,
    edit_defaults                          => no_backup,
    edit_template                          => "$(sys.workdir)/roadshow_inputs/role/templates/eth_persistent.link.tmpl",
    classes                                => if_repaired("reboot");

commands:

 reboot:: 
  "/usr/sbin/shutdown -r 3";

reports:

  "$(this.bundle) zone: $(zone)";
  "$(this.bundle) nic en mac: $(nic), $(mac)";
 
}
