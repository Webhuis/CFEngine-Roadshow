bundle agent osi_123(zone) {

vars:

  "zone_index"                                  slist => getindices($(zone));
 #"zone"                                        slist => { "$(zone[$(zone_index)])" };

  "gateway_line"                               string => execresult("/usr/sbin/ip route list match 0", noshell);
  "gateway_line_list"                           slist => splitstring( $(gateway_line), " ", "20");
  "gateway_device"                             string => nth("gateway_line_list", "4");
  "gateway_ip"                                 string => nth("gateway_line_list", "2");
  "hosts_ip"                                   string => "$($(zone)[123][ip])";
  "admin_ip"                                   string => "$($(zone)[22][ip])";

methods:

  "We require the loopback interface"       usebundle => l0_interface;

  "Interfaces predictable names"            usebundle => configure_interfaces("$($(zone)[$(zone_index)][nic])"
                                                                             ,"$($(zone)[$(zone_index)][ip])");

  "supply etc_hosts with a valid IP"        usebundle => etc_hosts;
  "openssh server and client"               usebundle => sshd_config;
 #"Host data driven policies go here"       usebundle => host_data_driven_policies;
 #"Domain data driven policies go here"     usebundle => domain_data_driven_policies; # one bundle for all?

reports:

  "$(this.bundle) zone: $($(osi_123.zone))";
  "$(this.bundle) zone_index: $(zone_index)";
  "$(this.bundle) zone nic: $($(zone)[$(zone_index)][nic])";
  "$(this.bundle) zone mac: $($(zone)[$(zone_index)][mac])";
  "$(this.bundle) zone ip: $($(zone)[$(zone_index)][ip])";
  "$(this.bundle) zone suffix: $($(zone)[$(zone_index)][suffix])";
  "$(this.bundle) zone vlan: $($(zone)[$(zone_index)][vlan])";

}
