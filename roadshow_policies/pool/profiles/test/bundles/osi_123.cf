bundle agent osi_123(ddns) {

vars:

  "zone_index"                                  slist => getindices($(ddns));
  "zone"                                        slist => { "$(ddns[$(zone_index)])" };

  "gateway_line"                               string => execresult("/usr/sbin/ip route list match 0", noshell);
  "gateway_line_list"                           slist => splitstring( $(gateway_line), " ", "20");
  "gateway_device"                             string => nth("gateway_line_list", "4");
  "gateway_ip"                                 string => nth("gateway_line_list", "2");

methods:

  "We require the loopback interface"       usebundle => l0_interface;

  "Interfaces predictable names"            usebundle => configure_interfaces("$(role_profile.ddns[$(role_profile.zone_index)][nic])"
                                                                             ,"$(role_profile.ddns[$(role_profile.zone_index)][ip])");

 #"Host data driven policies go here"       usebundle => host_data_driven_policies;

reports:

  "$(this.bundle) zone: $(osi_123.zone)";
  "$(this.bundle) ddns_index: $(zone_index)";
  "$(this.bundle) ddns content: $(osi_123.ddns[$(zone_index)][nic])";
  "$(this.bundle) ddns content: $(ddns[$(zone_index)][mac])";
  "$(this.bundle) ddns content: $(ddns[$(zone_index)][ip])";
  "$(this.bundle) ddns content: $(ddns[$(zone_index)][suffix])";
  "$(this.bundle) ddns content: $(ddns[$(zone_index)][vlan])";

}
