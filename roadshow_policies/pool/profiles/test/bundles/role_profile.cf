bundle agent role_profile {

vars:

  "zones"                              slist => { "123", "22" };

  "nic_index"                          slist => getindices("nic");
  "nic_values_unsorted"                slist => getvalues("nic");
  "nic_values"                         slist => sort("nic_values_unsorted", "lex");
  "nic_trick"                          slist => { "0", "1" };

  "ip[support]"                       string => "$(sys.ipv4[$(nic[support])])";
  "ip[admin]"                         string => "$(sys.ipv4[$(nic[admin])])";

  "ddns[support][ip]"                 string => "$(ip[support])";
  "ddns[support][nic]"                string => "$(nic[support])";
  "ddns[support][suffix]"             string => "";
  "ddns[support][vlan]"               string => "$($(classify.organisation).vlan[support])";
  "ddns[admin][ip]"                   string => "$(ip[admin])";
  "ddns[admin][nic]"                  string => "$(nic[admin])";
  "ddns[admin][suffix]"               string => "-ssh";
  "ddns[admin][vlan]"                 string => "$($(classify.organisation).vlan[admin])";

  "ddns_index"                         slist => getindices("ddns");

  "hosts_ip"                          string => "$(ip[support])";
  "admin_ip"                          string => "$(ip[admin])";

methods:

  "We need well configured zones"  usebundle => "zone_status_$(zones)";

reports:

  "$(this.bundle) nic: $(nic[$(nic_index)])";
  "$(this.bundle) nic_index: $(nic_index)";
  "$(this.bundle) nic_values: $(nic_values)";
  "$(this.bundle) hosts_ip: $(hosts_ip)";
  "$(this.bundle) admin_ip: $(admin_ip)";
  "$(this.bundle) ddns: $(ddns[$(ddns_index)][ip])";

}

bundle common zone_status_22 {

classes:

  "22_var"                            expression => isvariable("22_ip");
  "22_ip"                             expression => regcmp("^((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}$", "22_ip)"),
                                      comment    => "Process the IP Addresses.";

vars:

  "22_raw"                                string => execresult("$($(sys.flavor).ip_cmd) r show dev $($(classify.organisation).zone[22][nic]))","noshell");
  "22_list"                                slist => string_split("$(22_raw)", "src ", 9);
  "22_ip"                                 string => lastnode("$(22_list)", " " );

reports:

  "$(this.bundle) nic: $($(classify.organisation).zone[22][nic])";
  "$(this.bundle) ip: $(22_ip)";

}


bundle common zone_status_123 {

classes:

  "123_var"                           expression => isvariable("123_ip");
  "123_ip"                            expression => regcmp("^((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}$", "123_ip)"),
                                      comment    => "Process the IP Addresses.";

vars:

  "123_raw"                               string => execresult("$($(sys.flavor).ip_cmd) r show dev $($(classify.organisation).zone[123][nic]))","noshell");
  "123_list"                               slist => string_split("$(123_raw)", "src ", 9);
  "123_ip"                                string => lastnode("$(123_list)", " " );

reports:

  "$(this.bundle) nic: $($(classify.organisation).zone[123][nic])";
  "$(this.bundle) nic: $(123_ip)";

}

