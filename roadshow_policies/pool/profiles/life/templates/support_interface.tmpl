# Webhuis template for interfaces in /etc/network/interfaces.d
# Overcomes the issues of the very unpredictable predictable interface names.
# Interface names are hard linked to mac addresses on vlans
#
# Do not edit
#
[%CFEngine any:: %]

auto vlan$(role_profile.vlan[support])
iface vlan$(role_profile.vlan[support]) inet static
  address $(role_profile.hosts_ip)/24
  gateway $(support_interface.gateway_ip)
  ovs_bridge vmbr0
  ovs_options tag=$(role_profile.vlan[support])
  ovs_mtu 1500

