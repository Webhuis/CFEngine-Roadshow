# Webhuis template for interfaces in /etc/network/interfaces.d
# Overcomes the issues of the very unpredictable predictable interface names.
# Interface names are hard linked to mac addresses on vlans
#
# Do not edit
#
[%CFEngine any:: %]

auto vlan$(role_profile.vlan[life])
iface vlan$(role_profile.vlan[life]) inet static
  address $(role_profile.ip[life])/24
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=$(role_profile.vlan[life])
  ovs_mtu 9000

