# Webhuis template for apt_periodic
#
# Do not edit
#
[%CFEngine any:: %]

# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

auto lo
iface lo inet loopback

auto vmbr0
iface vmbr0 inet manual
  ovs_type OVSBridge
  ovs_ports eth0 vlan22 vlan42 vlan80 vlan111 vlan123 vlan213 vlan254 vlan1001 vlan1111
  ovs_mtu 8192

  # Lower settings for shorter convergence times, we're on a fast network.
  # Set the priority high so that it won't be promoted to the STP root
  # NOTE: ovs_options and ovs_extra do *not* work for some reason to set the STP
  #       options.
  #up ovs-vsctl set Bridge ${IFACE}
  # Wait for spanning-tree convergence
  # post-up sleep 10

auto eth0
iface eth0 inet manual
  ovs_bridge vmbr0
  ovs_type OVSPort
   # Use cost 20000, 40000, 60000 for node 1, 2, 3 (primary 1G port on each node, in preference order)
  # ovs_options tag=1 vlan_mode=native-untagged other_config:rstp-enable=true other_config:rstp-path-cost=20000 other_config:rstp-port-admin-edge=false other_config:rstp-port-auto-edge=false other_config:rstp-port-mcheck=true
  ovs_mtu 8192
  offload-tx  off
  offload-sg  off
  offload-tso off

auto vlan22
iface vlan22 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=22
  ovs_mtu 1500

auto vlan42
allow-hotplug vlan42
iface vlan42 inet static
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=42
  address 10.168.171.17
  netmask 255.255.255.0
  ovs_mtu 8192

auto vlan80
iface vlan80 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=80
  ovs_mtu 1500

auto vlan123
iface vlan123 inet static
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=123
  address 10.68.171.17
  netmask 255.255.255.0
  gateway 10.68.171.1
  ovs_mtu 1500

auto vlan213
iface vlan213 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=213
  ovs_mtu 1500

auto vlan254
iface vlan254 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=254
  ovs_mtu 1500

auto vlan1001
iface vlan1001 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=1001
  ovs_mtu 1500

auto vlan1111
iface vlan1111 inet manual
  ovs_type OVSIntPort
  ovs_bridge vmbr0
  ovs_options tag=1111
  ovs_mtu 1500

source /etc/network/interfaces.d/*

