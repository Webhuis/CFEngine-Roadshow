# Webhuis template for persistent links in /etc/systemd/network
# Overcomes the issues with the very unpredictable predictable interface names.
# Interface names are hard linked to mac addresses on vlans
#
# Do not edit
#
[%CFEngine any:: %]
#!/bin/bash

/usr/sbin/ethtool -K eth0 rx off tx off

/bin/echo 0 > /sys/class/net/vmbr0/bridge/multicast_snooping

#/usr/sbin/ip link set dev vmbr0 type bridge vlan_filtering 1
