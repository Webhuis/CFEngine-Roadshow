bundle agent life_interface(vlan_life) {

vars:

  "vlan"                            string => concat("vmbr0.", "$(vlan_life)");
  "vlan_can"                        string => canonify($(vlan));
  "vlan_ip"                         string => "$(sys.ipv4[($(vlan_can))]);

files:

 has_life_var::
  "/etc/network/interfaces.d/$(vlan)"
    comment                                => "vlan life interface",
    create                                 => "true",
    perms                                  => mo("644", "root"),
    action                                 => immediate,
    edit_defaults                          => no_backup,
    edit_template                          => "$(sys.workdir)/roadshow_inputs/role/templates/life_interface.tmpl",
    classes                                => if_repaired("restart_network");

commands:

 restart_network::

  "/usr/bin/systemctl restart networking";


reports:

  "$(this.bundle): vlan life interface $(vlan)";

}

