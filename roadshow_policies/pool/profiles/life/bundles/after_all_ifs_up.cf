bundle agent after-all-ifs-up {

vars:

  "mac_address"                     string => "$(sys.hardware_mac[eth0])";

files:

  "/etc/systemd/network/*"
    file_select    => all,
    delete         => tidy;

  "/etc/network/after-all-ips-up"
    comment                                => "one file per nic",
    create                                 => "true",
    perms                                  => mo("755", "root"),
    action                                 => immediate,
    edit_defaults                          => no_backup,
    edit_template                          => "$(sys.workdir)/roadshow_inputs/role/templates/after_all_ifs_up.tmpl",
    classes                                => if_repaired("reboot");

commands:

 reboot:: 
  "/usr/sbin/shutdown -r 3";

reports:

  "$(this.bundle) mac eth0: $(mac_address)";
 
}
