bundle common role_profile {

classes:

  "has_bridge_ports"               expression => isvariable("bridge_ports");
  "has_layer_2"                    expression => isvariable("layer_2");
  "has_layer_3"                    expression => isvariable("layer_3");
  "has_ddns_index"                 expression => isvariable("ddns_index");
  "has_hosts_var"                  expression => isvariable("hosts_ip");
  "has_life_var"                   expression => isvariable("life_ip");
  "available_vlan_$(vlan)"         expression => execresult("$($(sys.flavor).ip_cmd) link show dev $(var_vlan_$(vlan))","noshell");

 has_bridge_ports::
  "no_device_$(bridge_ports)"      expression => regcmp( ".*does not exist.*",
                                                         "$(var_$(bridge_ports))");
  "if_down_$(bridge_ports)"        expression => regcmp( ".*DOWN.*",
                                                         "$(var_$(bridge_ports))");
 
 has_hosts_var::
  "valid_hosts_ip"                 comment    => "Process the IP Addresses.",
                                   expression => regcmp("(1[0-9]{0,2}|[3-9][0-9]{0,1}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])",
            "$(hosts_ip)"
            );
 has_life_var::
  "valid_life_ip"                  comment    => "Process the IP Addresses.",
                                   expression => regcmp("(1[0-9]{0,2}|[3-9][0-9]{0,1}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])[\.]([0-1]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])",
            "$(life_ip)"
            );

vars:

  "vlan[support]"                     string => "$($(classify.organisation).vlan[support])";
  "vlan[life]"                        string => "$($(classify.organisation).vlan[life])";

  "vlan_numbers"                       slist => getvalues("$(classify.organisation).vlan");
  "layer_3"                            slist => { "42", "123" };
  "layer_2_step_1"                     slist => filter("42", "vlan_numbers", "true", "true", 99);
  "layer_2"                            slist => filter("123", "layer_2_step_1", "true", "true", 99);
  "vlans_sorted"                       slist => sort("vlan_numbers", "int");
  "bridge_ports_raw"                  string => join(" vmbr0.", vlans_sorted);
  "bridge_vlans"                      string => concat("vmbr0.", "$(bridge_ports_raw)");
  "bridge_ports"                      string => concat("eth0 vmbr0", "$(bridge_ports_raw)");
  "bridge_interfaces"                 string => concat("eth0 vmbr0 vmbr0.", "$(bridge_ports_raw)");
  "bridge_interfaces_list"             slist => string_split($(bridge_interfaces), " ", "20");
  "vlan_life"                         string => concat("vmbr0.", "$(vlan[life])");
  "vlan_support"                      string => concat("vmbr0.", "$(vlan[support])");

  #"var_$(bridge_ports)"              string => execresult("$($(sys.flavor).ip_cmd) link show dev $(bridge_ports)","noshell");

  "ip[support]"                       string => "$(sys.ipv4[$(vlan[support])])";
  "ip[life]"                          string => "$(sys.ipv4[$(vlan[life])])";

  "ddns[support][ip]"                 string => "$(ip[support])";
  "ddns[support][mac]"                string => "$(sys.hardware_address[$(ip[support])])";
  "ddns[support][vlan]"               string => "$(vlan[support])";
  "ddns[support][suffix]"             string => "";
  "ddns[support][vlan]"               string => "$($(classify.organisation).vlan[support])";
  "ddns[life][ip]"                    string => "$(ip[life])";
  "ddns[life][mac]"                   string => "$(sys.hardware_address[$(ip[life])])";
  "ddns[life][vlan]"                  string => "$(vlan[life])";
  "ddns[life][suffix]"                string => "-life";
  "ddns[life][vlan]"                  string => "$($(classify.organisation).vlan[life])";

  "ddns_index"                         slist => getindices("ddns");

  "hosts_ip"                          string => "$(ip[support])";
  "life_ip"                           string => "$(ip[life])";

reports:

  "$(this.bundle) vlan support: $(vlan[support])";
  "$(this.bundle) vlan life: $(vlan[life])";
  "$(this.bundle) bridge vlans: $(bridge_vlans)";
  "$(this.bundle) bridge ports: $(bridge_ports)";
  "$(this.bundle) bridge interfaces: $(bridge_interfaces)";
  "$(this.bundle) bridge interfaces_list: $(bridge_interfaces_list)";
  "$(this.bundle) hosts_ip: $(hosts_ip)";
  "$(this.bundle) life_ip: $(life_ip)";
  "$(this.bundle) ddns: $(ddns[$(ddns_index)][ip])";

}

