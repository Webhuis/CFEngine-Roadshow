bundle agent etc_hosts {

files:

 valid_hosts_ip::
  "/etc/hosts"
  comment                   => "/etc/hosts for main stream hosts",
  create                    => "true",
  perms                     => mo("644","root"),
  edit_template             => "$(sys.workdir)/roadshow_inputs/role/templates/etc_hosts.tmpl",
  action                    => r_immediate;

reports:

 valid_hosts_ip::
  "$(this.bundle) etc_hosts_ip: $(role_profile.ip[support])";

 !valid_hosts_ip::
   "$(this.bundle): etc_hosts_ip bad hosts_ip! $(role_profile.ip[support])";

}
