# Webhuis template for interfaces in /etc/network/interfaces.d
# Overcomes the issues of the very unpredictable predictable interface names.
# Interface names are hard linked to mac addresses on vlans
#
# Do not edit
#
[%CFEngine any:: %]

allow-hotplug $(configure_interfaces.current_device)
auto $(configure_interfaces.current_device)
iface $(configure_interfaces.current_device) inet static
  address $(configure_interfaces.current_ip)
[%CFEngine gateway:: %]
  gateway $(osi_123.gateway_ip)
