[%CFEngine any:: %]
dn: cn=$(dhcp_ldap_update.ddns_name_$(nic)),cn=fixed,cn=$(dhcp_ldap_update.subnet_$(nic)),cn=$(dhcp_ldap_update.vlan_$(nic)),cn=dhcp,dc=sw,dc=webhuis,dc=nl
cn: $(dhcp_ldap_update.ddns_name_$(nic))
dhcpHWAddress: ethernet $(dhcp_ldap_update.mac_address_$(nic))
