bundle common zone_254 {

classes:

  "254_nic"                           expression => regcmp(".*eth.*", "$(254_link)");
  "254_var"                           expression => isvariable("254_ip");
  "254_ip"                            expression => regcmp("^((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}$", "$(254_ip)");

vars:

  "254_nic"                               string => "$($(classify.organisation).zone[254][nic])";
  "254_link"                              string => execresult("$($(sys.flavor).ip_cmd) a show dev $(254_nic)","noshell");
  "254_mac"                               string => "$(sys.hardware_mac[$(254_nic)])";
  "254_raw"                               string => execresult("$($(sys.flavor).ip_cmd) r show dev $(254_nic)","noshell");
  "254_list"                               slist => string_split("$(254_raw)", "src ", 9);
  "254_ip"                                string => lastnode("$(254_list)", " " );

reports:

  "$(this.bundle) nic: $($(classify.organisation).zone[254][nic])";
  "$(this.bundle) show dev: $(254_raw)";
  "$(this.bundle) ip: $(254_ip)";
  "$(this.bundle) mac: $(254_mac)";

 254_nic::
  "$(this.bundle) nic 254 available";
  "$(this.bundle) nic 254: $(254_nic)";
 !254_nic::
  "$(this.bundle) nic 254 is not available";

 254_ip::
  "$(this.bundle) ip 254 available";
  "$(this.bundle) ip 254: $(254_ip)";
 !254_ip::
  "$(this.bundle) ip 254 not available";

}

