bundle agent check_interfaces(zone) {

vars:

  "nic"                               string => "zone_$(zone).$(zone)_nic";

commands:

 "!($zone)_nic":: 
  "/usr/sbin/ip link set dev $(nic) up";
  "/usr/bin/systemctl restart networking";

reports:

  "$(this.bundle): I am checking nics and mac: $(nic).";

 "!($zone)_nic":: 
  "$(this.bundle): setting nic $(nic) up and restarting network";

}
