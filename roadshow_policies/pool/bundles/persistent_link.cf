bundle agent persistent_link (pos) {
 
classes:

  "if_nic"                      expression => strcmp( "$(interface)", "$(nic)" ); 

vars:

  "interface_line"                           string => nth("interface_nic.nic_lines", "$(pos)");
  "interface_list"                            slist => string_split($(interface_line), ": ", 9);
  "interface"                                string => nth("interface_list", "1");
  "mac_address"                              string => execresult("/usr/bin/cat /sys/class/net/$(interface)/address", noshell);

 #"zones"                                     slist => { "$(role_profile.zones)" };
  "zones"                                    string => nth("$(role_profile.zones)", "$(pos)");
  "nic"                                      string => "$(zone_$(zones).$(zones)_nic)";

files:

#!if_nic::

# "/etc/systemd/network/$(nic)_persistent.link"
#   comment                                         => "one file per nic",
#   create                                          => "true",
#   perms                                           => mo("644", "root"),
#   action                                          => immediate,
#   edit_defaults                                   => no_backup,
#   edit_template                                   => "$(sys.workdir)/roadshow_inputs/role/templates/eth_persistent.link.tmpl",
#   classes                                         => if_repaired("update_grub");

methods:

 update_grub::

  "Grub needs to be updated"              usebundle => update_grub,
                                            classes => if_repaired("reboot");

reports:

  "$(this.bundle) zones: $(zones)";
  "$(this.bundle) zone: $(role_profile.zones)";
  "$(this.bundle) if and nic: $(interface), $(mac_address), $(nic), $(zones)";
 
}
