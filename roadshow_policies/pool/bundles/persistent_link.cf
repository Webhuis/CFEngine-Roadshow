bundle agent persistent_link (pos) {
 
classes:

  "if_nic"                      expression => strcmp( "$(interface)", "$(nic)" ); 

vars:

  "interface"                                string => nth("interface_nic.interfaces_available", "$(pos)");
  "mac"                                      string => "$(sys.hardware_mac[$(interface)])";
  "zones"                                    string => nth("role_profile.zones", "$(pos)");
  "nic"                                      string => "$(zone_$(zones).$(zones)_nic)";

files:

 !if_nic::

  "/etc/systemd/network/$(nic)_persistent.link"
    comment                                         => "one file per nic",
    create                                          => "true",
    perms                                           => mo("644", "root"),
    action                                          => immediate,
    edit_defaults                                   => no_backup,
    edit_template                                   => "$(sys.workdir)/roadshow_inputs/role/templates/eth_persistent.link.tmpl",
    classes                                         => if_repaired("update_grub");

methods:

 update_grub::

  "Grub needs to be updated"              usebundle => update_grub,
                                            classes => if_repaired("reboot");

reports:

  "$(this.bundle) nic en mac: $(nic), $(mac_address)";
  "$(this.bundle) paired: $(nic), $(pos), $(mac_address)";
 
}
