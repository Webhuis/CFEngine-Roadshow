bundle agent etc_hosts {

files:

 "$(role_profile.hosts_zone)_ip"::
  "/etc/hosts"
  comment                   => "/etc/hosts for main stream hosts",
  create                    => "true",
  perms                     => mo("644","root"),
  edit_template             => "$(sys.workdir)/roadshow_inputs/role/templates/etc_hosts.tmpl",
  action                    => r_immediate;

reports:

 "$(role_profile.hosts_zone)_ip"::
  "$(this.bundle) hosts_ip $(zone_$(hosts_zone).$(hosts_zone)_ip)";

}
