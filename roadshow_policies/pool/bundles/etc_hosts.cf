bundle agent etc_hosts {

files:

 valid_hosts_ip::
  "/etc/hosts"
  comment                   => "/etc/hosts voor elke hosti, let op voor de uitzondering etcd moet de template naam een role gerelateerde variabele zijn",
  create                    => "true",
  perms                     => mo("644","root"),
  edit_template             => "$(sys.workdir)/roadshow_inputs/templates/etc_hosts.tmpl",
  action                    => r_immediate;

reports:

 valid_hosts_ip::
  "$(this.bundle) etc_hosts_ip: $(role_profile.hosts_ip)";

 !valid_hosts_ip::
   "$(this.bundle): etc_hosts_ip bad hosts_ip! $(role_profile.hosts_ip)";

}
