bundle agent gateways_gateway {

vars:

  "gateways_gateway.cf"     string => "I am the Gateway of Gateways";

files:

  "/usr/local/bin/local-rules.sh"
         comment  => "local firewall config",
           perms  => mog("755","root","root"),
          create  => "true",
          action  => r_immediate,
   edit_template  => "$(sys.workdir)/roadshow_inputs/templates/igwy-rules.tmpl",
         classes  => r_if_repaired("restart_firewall");

  "/usr/local/bin/local-ipv6-rules.sh"
         comment  => "disable ipv6",
           perms  => mog("755","root","root"),
          create  => "true",
          action  => r_immediate,
   edit_template  => "$(sys.workdir)/roadshow_inputs/templates/local-ipv6-rules.tmpl",
         classes  => r_if_repaired("restart_firewall");

methods:

  "We needs our peers to do the job"  usebundle => keepalive;

commands:

 restart_firewall::
  "/usr/local/bin/local-rules.sh";

reports:

  "${this.bundle}: ";

}
