bundle agent keepalive {

vars:

  "pkg[keepalived]"	   	   	string => "*";

  "templates"                            slist => { "keepalived.conf.tmpl" };

files:

  "/etc/keepalived/keepalived.conf"
   perms             => mo("644","root"),
   create            => "true",
   action            => r_immediate,
   edit_template     => "$(sys.workdir)/roadshow_inputs/components/templates/keepalived.conf.tmpl",
   classes           => r_if_repaired("restart_keepalived");

methods:
 
  "We want to know our peers"                  usebundle => keepalived_peers;

commands:

 restart_keepalived::

  "/etc/init.d/keepalived restart";

reports:

  "$(this.bundle) Packages: $(pkg)";
 #$(this.bundle) my_keepalived_priority: $(my_keepalived_priority)";
 #"$(this.bundle) my_keepalived_peers: $(my_keepalived_peers)";

}

bundle agent keepalived_peers {

vars:

  "pkg[haproxy]"                        string => "*";

reports:

  "$(this.bundle): Configure gateway";

}

