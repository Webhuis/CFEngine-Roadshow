bundle agent keepalive {

vars:

  "pkg[keepalived]"	   	   	string => "*";

files:

  "/etc/keepalived/keepalived.conf"
   perms             => mo("644","root"),
   create            => "true",
   action            => r_immediate,
   edit_template     => "$(sys.workdir)/roadshow_inputs/components/templates/keepalived.conf.tmpl",
   classes           => r_if_repaired("restart_keepalived");

methods:

  "We are a keepalive peer"         usebundle => packages("keepalive.pkg");

commands:

 restart_keepalived::

  "/usr/bin/systemctl restart keepalived";

reports:

  "$(this.bundle) Packages: $(pkg)";
  "$(this.bundle) Priority: $($(role_profile.keepalive_ipv4_4)";

}
