bundle agent keepalive {

vars:

  "keepalive_vip"                     string => "$($(classify.domain).ggwy_vip)";
  "keepalive_nic"                     string => "$(zone_$(role_profile.gw_zone).$(role_profile.gw_zone)_nic)";

  "ip_can_prio"                       string => canonify("$(zone_$(role_profile.gw_zone).$(role_profile.gw_zone)_ip)"); 
  "ip_list_prio"                       slist => string_split("$(ip_can_prio)", "src ", 99); 
  "keepalive_prio"                    string => lastnode("$(ip_list_prio)", "_" );

  "ip_can_vrid"                       string => canonify("$($(classify.domain).ggwy_vip)");
  "ip_list_vrid"                       slist => string_split("$(ip_can_vrid)", "src ", 99);
  "keepalive_vrid"                    string => lastnode("$(ip_list_vrid)", "_" );

  "keepalive_routes"                  string => "$($(classify.domain).ggwy_routes)";

  "pkg[keepalived]"	   	   	string => "*";

files:

  "/etc/keepalived/keepalived.conf"
   perms             => mo("644","root"),
   create            => "true",
   action            => r_immediate,
   edit_template     => "$(sys.workdir)/roadshow_inputs/components/templates/keepalived.conf.tmpl",
   classes           => r_if_repaired("restart_keepalived");

methods:

  "We are a keepalive peer"         usebundle => packages("keepalive.pkg");

commands:

 restart_keepalived::

  "/usr/bin/systemctl restart keepalived";

reports:

  "$(this.bundle) Packages: $(pkg)";
  "$(this.bundle) Priority: $(zone_$(role_profile.gw_zone).$(role_profile.gw_zone)_nic)";
  "$(this.bundle) Priority: $(zone_$(role_profile.gw_zone).$(role_profile.gw_zone)_ip)";

}
