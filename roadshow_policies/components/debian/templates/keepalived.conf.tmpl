# Webhuis template voor keepalived.conf
#
# Do not edit
#
[%CFEngine any:: %]
! Configuration File for keepalived

global_defs {
  notification_email {
    martin@webhuis.nl
  }
  notification_email_from keepalived@$(sys.fqhost)
  smtp_server mailsw.webhuis.nl
  smtp_connect_timeout 30
}

vrrp_instance $(role_profile.keepalive_vlan) {
  interface $(role_profile.keepalive_nic)
  virtual_router_id $(role_profile.keepalive_vlan)
  priority $(role_profile.keepalive_ipv4_4)
  advert_int 1
  authentication {
    auth_type PASS
      auth_pass 1111
  }
  virtual_ipaddress {
    $(role_profile.keepalive_vip)
  }
  virtual_routes {
    $($(classify.domain).ggwy_routes[$(ggwy_routes_index)]) via $($(classify.domain).ggwy_routes_index)) dev $(role_profile.keepalive_nic)
  }
}
