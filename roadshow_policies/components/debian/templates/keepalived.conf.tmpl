# Webhuis template voor keepalived.conf
#
# Do not edit
#
[%CFEngine any:: %]
! Configuration File for keepalived

global_defs {
  notification_email {
    martin@webhuis.nl
  }
  notification_email_from keepalived@$(sys.fqhost)
  smtp_server mailsw.webhuis.nl
  smtp_connect_timeout 30
}

vrrp_instance $($(classify.organisation).vlan[gw]) {
  interface $(role_profile.keepalive_nic)
  virtual_router_id 101
  priority $(role_profile.keepalive_rank)
  advert_int 1
  authentication {
    auth_type PASS
      auth_pass 1111
  }
  virtual_ipaddress {
    $($(classify.domain).ggwy_vip)
  }
  virtual_routes {
    $($(classify.domain).ggwy_routes[ggwy_index) via $($(classify.domain).ggwy_index)
  }
}
