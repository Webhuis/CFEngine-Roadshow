bundle agent life_gwy {

vars:

  "pkg[firefox-esr]"                    string => "*";
  "pkg[git]"                            string => "*";
  "pkg[iptabes]"                        string => "*";
  "pkg[konsole]"                        string => "*";
  "pkg[unzip]"                          string => "*";
  "pkg[zip]"                            string => "*";

methods:

  "provide desktop packages"         usebundle => packages("life_gwy.pkg");

reports:

  "${this.bundle}: role";

}

