# Webhuis template voor ggwy keepalived.conf
#
# Do not edit
#
[%CFEngine any:: %]
! Configuration File for keepalived

global_defs {
  notification_email {
    martin@webhuis.nl
  }
  notification_email_from keepalived@$(sys.fqhost)
  smtp_server mailsw.webhuis.nl
  smtp_connect_timeout 30
}

vrrp_instance $(keepalive.keepalive_nic) {
  interface $(keepalive.keepalive_nic)
  virtual_router_id $(keepalive.keepalive_vrid)
  priority $(keepalive.keepalive_prio)
  advert_int 1
  authentication {
    auth_type PASS
      auth_pass 1111
  }
  virtual_ipaddress {
    $(keepalive.keepalive_vip) dev $(keepalive.keepalive.nic)
  }
  virtual_routes {
    $($(classify.domain).ggwy_routes[$($(classify.domain).ggwy_routes_index)]) via $($(classify.domain).ggwy_routes_index) dev $(keepalive.keepalive_nic)
  }
}
