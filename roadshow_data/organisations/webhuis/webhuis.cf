bundle common webhuis {

vars:

  "organisation"                       string => "Webhuis";
  "administrator"                      string => "martin@webhuis.nl";

  "dhcp_ldap"                          string => "mihrwhpdcsw1.sw.webhuis.nl";
  "ldap_frontend"                      string => "ldap.sw.webhuis.nl";
  "ldap_vip"                           string => host2ip("$(ldap_frontend)");
  "ldap_m[ldappdcsw001.sw.webhuis.nl]" string => "100";
  "ldap_m[ldappdcsw002.sw.webhuis.nl]" string => "101";
  "mdns"                               string => "powerdns.webhuis.nl";
  "mdns_key"                           string => "/etc/dhcp/webhuis.nl.update";
  "local_networks"                     string => "10.0.0.0/8 192.168.0.0/16 213.127.130.120/29";

  "ttl"                                string => "300";
  "ntp_server"                         string => "ntp.time.nl";

  "zone[123][nic]"                     string => "eth0";
  "zone[123][suffix]"                  string => "";
  "zone[123][vlan]"                    string => "support";
  "zone[22][nic]"                      string => "eth1";
  "zone[22][suffix]"                   string => "-ssh";
  "zone[22][vlan]"                     string => "admin";
  "zone[1001][nic]"                    string => "eth2";
  "zone[1001][suffix]"                 string => "-int";
  "zone[1001][vlan]"                   string => "home";
  "zone[213][nic]"                     string => "eth3";
  "zone[213][suffix]"                  string => "-wan";
  "zone[213][vlan]"                    string => "wan";
  "zone[254][nic]"                     string => "eth4";
  "zone[254][suffix]"                  string => "-gw";
  "zone[254][vlan]"                    string => "gw";
  "zone[42][nic]"                      string => "eth5";
  "zone[42][suffix]"                   string => "-life";
  "zone[42][vlan]"                     string => "life";
  "zone[80][nic]"                      string => "eth6";
  "zone[80][suffix]"                   string => "-app";
  "zone[80][vlan]"                     string => "apps";
  "zone[111][nic]"                     string => "eth7";
  "zone[111][suffix]"                  string => "-srv";
  "zone[111][vlan]"                    string => "service";
  "zone[1111][nic]"                    string => "eth8";
  "zone[1111][suffix]"                 string => "-rs";
  "zone[1111][vlan]"                   string => "roadshow";

  "vlan[home]"                         string => "1001";
  "vlan[support]"                      string => "123";
  "vlan[admin]"                        string => "22";
  "vlan[wan]"                          string => "213";
  "vlan[gw]"                           string => "254";
  "vlan[life]"                         string => "42";
  "vlan[apps]"                         string => "80";
  "vlan[service]"                      string => "111";
  "vlan[roadshow]"                     string => "1111";

  "nic[home]"                          string => "eth0";
  "nic[support]"                       string => "eth1";
  "nic[admin]"                         string => "eth2";
  "nic[wan]"                           string => "eth3";
  "nic[gw]"                            string => "eth4";
  "nic[life]"                          string => "eth5";
  "nic[apps]"                          string => "eth6";
  "nic[service]"                       string => "eth7";
  "nic[roadshow]"                      string => "eth8";

reports:

  "$(this.bundle): Infrastructure data";

}
